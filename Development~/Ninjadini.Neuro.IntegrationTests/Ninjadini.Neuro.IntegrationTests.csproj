<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>disable</Nullable>

        <ImplicitUsings>disable</ImplicitUsings>
        <LangVersion>9</LangVersion>

        <IsPackable>false</IsPackable>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="NUnit" Version="3.14.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
        <PackageReference Include="NUnit.Analyzers" Version="3.10.0" />
        <PackageReference Include="coverlet.collector" Version="6.0.4" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Ninjadini.Neuro\Ninjadini.Neuro.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\Tests\Integration\**\*.cs">
            <Link>Integration\%(RecursiveDir)\%(Filename)%(Extension)</Link>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <Analyzer Include="..\..\Ninjadini.Neuro\CodeGen\netstandard2.0\Ninjadini.Neuro.CodeGen.dll" />
    </ItemGroup>
</Project>
